// Cloudflare Workers deployment for the built site.
//
// There is no Worker script here, and that is deliberate: `assets.directory`
// tells Wrangler to upload `dist/` as static assets and serve them directly,
// so no request ever invokes code of ours. `dist/` comes from `npm run build`
// and must exist before `wrangler deploy` runs — Wrangler uploads whatever is
// on disk and does not build for you.
//
// `not_found_handling: single-page-application` answers unmatched paths with
// index.html. Routing in this app is hash-based, so deep links like
// `/#/instagram` are fragments the server never sees — this only covers
// typo'd or truncated paths, where the homepage is the useful answer.
{
  "name": "motion-portfolio",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
